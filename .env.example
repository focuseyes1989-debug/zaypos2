APP_NAME="ZAY POS System 2.0"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/zaypos2/public
APP_TIMEZONE=Asia/Yangon

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=zay_pos_2
DB_USERNAME=zaypos_app
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_CHARSET=utf8mb4

SESSION_NAME=zaypos2_session
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

SESSION_ABSOLUTE_LIFETIME_MINUTES=720
SESSION_ROTATE_MINUTES=30
SESSION_BIND_USER_AGENT=true
PASSWORD_MIN_LENGTH=12
